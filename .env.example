APP_ENV=local
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=face-photos
SUPABASE_STORAGE_REQUIRED=false

# Image storage: auto, local, supabase, cloudinary.
# In auto mode, Cloudinary is used first when configured.
# Cloudinary
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

IMAGE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_FOLDER=facemaxx

# Local development only. Set false before production.
AUTH_DISABLED=true
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# Facemaxx face-analysis AI provider: openai, dummy.
# Older Gemini provider values are accepted but route Facemaxx analysis to OpenAI.
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Gemini remains available only for adjacent app-service paths that still opt into it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_RETRY_ATTEMPTS=1
GEMINI_RETRY_BASE_DELAY_SECONDS=0.8

# Flirtist dating coach AI provider: mock, openai, anthropic, gemini, codex_cli.
# These are server-only. Never put provider keys in the iOS app.
# Codex CLI is the primary path; the configured API provider is used only when
# the CLI is unavailable, times out, or returns an invalid response.
FLIRTIST_AI_PROVIDER=codex_cli
FLIRTIST_AI_FALLBACK_PROVIDER=openai
FLIRTIST_OPENAI_API_KEY=
FLIRTIST_OPENAI_MODEL=gpt-4.1-mini
FLIRTIST_ANTHROPIC_API_KEY=
FLIRTIST_ANTHROPIC_MODEL=claude-sonnet-4-5
FLIRTIST_GEMINI_API_KEY=
FLIRTIST_GEMINI_MODEL=gemini-3-flash-preview
FLIRTIST_CODEX_MODEL=gpt-5.6-luna
# Codex calls this reasoning effort "low"; this is the requested light setting.
FLIRTIST_CODEX_REASONING_EFFORT=low
FLIRTIST_CODEX_BIN=/usr/local/bin/codex
FLIRTIST_CODEX_TIMEOUT_SECONDS=45
FLIRTIST_CODEX_MAX_CONCURRENCY=2
CODEX_HOME=/home/app/.codex

# RevenueCat
# Server-side secret key, not the iOS public SDK key.
REVENUECAT_SECRET_API_KEY=
# Optional bearer token configured in the RevenueCat webhook Authorization header.
REVENUECAT_WEBHOOK_BEARER_TOKEN=
